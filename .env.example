# Firebase web-app config. Copy this file to `.env` and fill in your values.
# Find these in Firebase console → Project settings → Your apps → Web app → Config.
#
# The app runs fine without any of this (fixtures only). Fill it in to switch
# the coach onto real Firebase AI Logic (hybrid on-device / cloud) inference.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 while developing locally (enables the App Check debug provider).
VITE_FIREBASE_APPCHECK_DEBUG=1

# Optional: pin the debug token printed in the console, so every browser and
# teammate uses the same registered token. Keep this out of git.
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
